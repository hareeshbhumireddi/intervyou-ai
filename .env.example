# Server-side Google Gemini API key (required for AI interview questions, evaluation, and resume analysis)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL (used for callbacks and self-referential links)
APP_URL="http://localhost:3000"

# Express server port (defaults to 3000)
PORT="3000"

# Runtime environment ("development" or "production")
NODE_ENV="development"

# Optional client API base URL override (defaults to "/api")
VITE_API_URL="/api"

# Optional Vite HMR toggle ("true" disables hot module reload)
DISABLE_HMR="false"

# Optional LinkedIn OAuth 2.0 App credentials (for live 3P "Continue with LinkedIn" OpenID profile sync)
# Configure Authorized Redirect URL in LinkedIn Developer Portal: <APP_URL>/api/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

